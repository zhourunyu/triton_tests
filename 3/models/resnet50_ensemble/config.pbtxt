platform: "ensemble"

input [
    {
        name: "IMAGE"
        data_type: TYPE_STRING
        dims: [ -1, 1 ]
    }
]
output [
    {
        name: "PREDICTIONS"
        data_type: TYPE_INT64
        dims: [ -1, 1000 ]
    },
    {
        name: "PROBABILITIES"
        data_type: TYPE_FP32
        dims: [ -1, 1000 ]
    }
]

ensemble_scheduling {
    step [
        {
            model_name: "resnet50_preprocess"
            model_version: -1
            input_map {
                key: "IMAGE"
                value: "IMAGE"
            }
            output_map {
                key: "PREPROCESSED_TENSOR"
                value: "PREPROCESSED_TENSOR"
            }
        },
        {
            model_name: "resnet50"
            model_version: -1
            input_map {
                key: "input"
                value: "PREPROCESSED_TENSOR"
            }
            output_map {
                key: "output"
                value: "LOGITS"
            }
        },
        {
            model_name: "resnet50_postprocess"
            model_version: -1
            input_map {
                key: "LOGITS"
                value: "LOGITS"
            }
            output_map {
                key: "PREDICTIONS"
                value: "PREDICTIONS"
            }
            output_map {
                key: "PROBABILITIES"
                value: "PROBABILITIES"
            }
        }
    ]
}
