backend: "onnxrt"
max_batch_size: 16
dynamic_batching {}

input [
    {
        name: "input"
        data_type: TYPE_FP32
        dims: [ 3, 224, 224 ]
    }
]
output [
    {
        name: "output"
        data_type: TYPE_FP32
        dims: [ 1000 ]
    }
]

instance_group [
    {
        count: 1
        kind: KIND_MODEL
    }
]